<form class="flexcol npc-narrator-dialog">
  <p class="npc-narrator-status {{#if bound}}ok{{/if}}">{{{statusHtml}}}</p>
  <div class="form-group">
    <label>Yaml Editor base URL</label>
    <input type="text" name="editorBaseUrl" value="{{editorBaseUrl}}" placeholder="https://editor.example.com" />
  </div>
  <div class="form-group">
    <label>Pairing code</label>
    <input type="text" name="pairingCode" value="{{pairingCode}}" placeholder="Paste one-time pairing code" autocomplete="off" />
    <p class="notes">Prefilled from module settings when available. Generate a code in the NPC Narrator DM console (Player Invites → Foundry VTT). Codes expire and can only be used once.</p>
  </div>
  <footer class="flexrow" style="gap:0.5rem;margin-top:0.75rem;">
    <button type="submit" name="bind"><i class="fas fa-link"></i> Bind world</button>
    <button type="button" class="npc-narrator-unbind"><i class="fas fa-unlink"></i> Unbind</button>
  </footer>
</form>
